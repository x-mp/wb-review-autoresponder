APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=change-me-to-at-least-32-random-characters
POSTGRES_DB=wb_assistant
POSTGRES_USER=wb_assistant
POSTGRES_PASSWORD=change-me-to-a-long-random-database-password
DATABASE_URL=postgresql://wb_assistant:change-me-to-a-long-random-database-password@postgres:5432/wb_assistant
ARTIFACT_ROOT=/app/data/raw
WB_API_TOKEN=
WB_API_BASE=https://feedbacks-api.wildberries.ru
WB_CONTENT_API_BASE=https://content-api.wildberries.ru
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=WB Review Assistant
LLM_MODE=mock
AUTO_PUBLISH=false
SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
